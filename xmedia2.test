for prefix in A B C D; do
  for i in $(seq -w 1 1000); do
    id=$(printf "%s%04d" $prefix $i)
    echo "#EXTINF:-1,Channel $id"
    echo "http://iptvcasomsapi.jprdigital.in/x-media/$id/master.m3u8"
  done
done
